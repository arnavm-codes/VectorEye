GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Attribute verification (optional, experimental, slow -- see README) --
# fixes CLIP's weak "blue car" attribute-object binding via an open-
# vocabulary object detector. Off by default: real added per-query latency.
# This only controls whether the detector is USED -- its weights are always
# downloaded by setup.sh/setup.bat along with every other model.
ENABLE_ATTRIBUTE_VERIFICATION=false
YOLO_WORLD_MODEL=yolov8l-worldv2.pt

# Object storage (Floci locally)
S3_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=us-east-1
S3_VERIFY_SSL=true
RAW_VIDEOS_BUCKET=raw-videos
PRESIGN_EXPIRY_SECONDS=3600   # how long a search result's clip_url stays valid

# Clips are never stored: each search hit's clip_url is a signed link that cuts the window out
# of the raw video on demand (ffmpeg) and caches it on local disk.
# CLIP_SIGNING_SECRET signs those links; the API and the Streamlit UI must share it, and the
# API refuses to start without it. setup.sh generates one when this is left empty.
CLIP_SIGNING_SECRET=
# API_PUBLIC_URL=http://localhost:9100
# CLIP_CACHE_MAX_MB=2048

# Service
VECTOREYE_PORT=9100

# On-screen text search (OCR, optional -- see README) -- searches slide/
# whiteboard/signage text via Tesseract. Off by default. Needs the
# tesseract-ocr system package installed separately (not a pip package --
# pytesseract is just a wrapper around the binary).
ENABLE_OCR_SEARCH=false
OCR_BACKEND=tesseract
