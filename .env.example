GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Attribute verification (optional, experimental, slow -- see README) --
# fixes CLIP's weak "blue car" attribute-object binding via an open-
# vocabulary object detector. Off by default: real added per-query latency.
# If set to true here before running setup.sh, the detector's weights get
# pre-downloaded during setup instead of on your first verified search.
ENABLE_ATTRIBUTE_VERIFICATION=false
YOLO_WORLD_MODEL=yolov8l-worldv2.pt

# On-screen text search (OCR, optional -- see README) -- searches slide/
# whiteboard/signage text via Tesseract. Off by default. Needs the
# tesseract-ocr system package installed separately (not a pip package --
# pytesseract is just a wrapper around the binary).
ENABLE_OCR_SEARCH=false
OCR_BACKEND=tesseract
