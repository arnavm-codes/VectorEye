# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Env vars / secrets
.env

# POC data -- videos and derived clips are local-only, not committed
data/raw_videos/*
!data/raw_videos/.gitkeep
data/clips/*
!data/clips/.gitkeep

# Downloaded model checkpoints -- large binaries, re-downloadable, not committed
data/model_cache/

# Change-detection fingerprint state (app/pipeline/change_detection.py) --
# local runtime state tied to this machine's data/raw_videos contents, not
# something to commit
data/.ingest_state.json

# YOLO-World weights (attribute-verification detector, any size -- l/m/s all
# benchmarked, see vault note) and its internal CLIP text encoder --
# ultralytics/its clip dependency download these to the repo root/`weights/`
# by default; same re-downloadable-binary reasoning as above.
yolov8*-worldv2.pt
weights/

