 "cards": [
  {
   "dot": "cyan",
   "title": "Ingest",
   "items": [
    "Each video is cut into 10 s clips, with a second pass offset by 5 s",
    "Clips are re-encoded to H.264 and uploaded to the chunks bucket",
    "A video whose S3 ETag and size are unchanged is skipped unless forced"
   ]
  },
  {
   "dot": "violet",
   "title": "Search",
   "items": [
    "The query is embedded with the same CLIP model as the clips",
    "Speech and OCR vectors fuse in with RRF when those options are on",
    "Each hit carries a presigned S3 URL for playback"
   ]
  },
  {
   "dot": "amber",
   "title": "Also in the API",
   "items": [
    "/chat adds Groq query cleanup, /clip proxies stored clips",
    "/sources lists or deletes a source, /retention/sweep expires old clips"
   ]
  }
 ]
